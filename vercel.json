{
  "functions": {
    "api/stripe-webhook.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/create-checkout.js": {
      "memory": 1024,
      "maxDuration": 10
    },
    "api/delete-user.js": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/stripe-webhook",
      "destination": "/api/stripe-webhook.js"
    },
    {
      "source": "/api/create-checkout",
      "destination": "/api/create-checkout.js"
    },
    {
      "source": "/api/delete-user",
      "destination": "/api/delete-user.js"
    }
  ],
  "headers": [
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
